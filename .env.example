# ============================================
# LexAduana — Variables de entorno
# ============================================
#
# Copia este fichero a `.env.local` y rellena con valores reales.
# Nunca commitees `.env.local` (está en .gitignore).

# ── Supabase (obligatorio) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude / Anthropic (opcional) ─────────────────────
# Sólo necesario si usas /clasificador o /factura-ocr.
ANTHROPIC_API_KEY=

# ── Upstash Redis (opcional — rate limiting) ──────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CBAM Nivel 2 · diagnóstico cualitativo ────────────
# Desde el Día 6, el Nivel 2 (/cbam/calculadora) entrega un diagnóstico
# cualitativo (semáforo + rangos) en vez de la cifra exacta en €. Esto
# diferencia claramente la herramienta gratuita del Advisory Básico.
#
# Si el feedback de clientes reales lo aconseja, puedes re-exponer la cifra
# exacta poniendo este flag a `true`. La lectura del flag es en backend, así
# que el cambio es efectivo para todos los usuarios en el siguiente despliegue
# (no requiere modificaciones de código).
#
# Valores permitidos: "true" (cifra visible) · cualquier otro (oculta).
# Default operativo: false.
NIVEL_2_SHOW_COST=false

# ── Playwright E2E ────────────────────────────────────
# Puerto dedicado para evitar colisión con `npm run dev` en 3000.
E2E_PORT=3100
# Si ya tienes un servidor arrancado en otra terminal, evita que Playwright
# arranque uno nuevo.
# E2E_SKIP_WEBSERVER=1
# URL base override (p. ej. para tests contra staging).
# E2E_BASE_URL=http://localhost:3100
